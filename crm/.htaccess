Options -Indexes
DirectoryIndex index.php
# Force HTTPS (skipped when opened by IP address, e.g. a test server)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^[0-9.]+(:[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
# Never serve config, git, or notes
<FilesMatch "^(config\.php|.*\.md|\.git.*|\.env.*|\.user\.ini)$">
  Require all denied
</FilesMatch>
# Allow larger uploads (they are compressed after upload). Hostinger also reads .user.ini; hPanel → PHP settings can raise these too.
<IfModule mod_php.c>
  php_value upload_max_filesize 60M
  php_value post_max_size 64M
  php_value memory_limit 768M
  php_value max_execution_time 300
</IfModule>
<IfModule LiteSpeed>
  php_value upload_max_filesize 60M
  php_value post_max_size 64M
  php_value memory_limit 768M
  php_value max_execution_time 300
</IfModule>
# Installable app (phone home screen)
<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "^sw\.js$">
  Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
